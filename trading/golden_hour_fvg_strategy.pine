//@version=6
strategy(
     title             = "Golden Hour – ICT FVG + Fractal TP v3 (Chanelle Style)",
     overlay           = true,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 5,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.02,
     slippage          = 2,
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_lines_count   = 500)

// ══════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════
var string G1 = "Sessions (New York Time)"
bool i_lon = input.bool(true, "London Open  02:00–05:00 ET", group=G1)
bool i_ny  = input.bool(true, "NY Open      08:00–11:00 ET", group=G1)

var string G2 = "Catalyst / FVG"
int   i_atr_len  = input.int  (14,  "ATR Length",                      group=G2, minval=1)
float i_cat_mult = input.float(1.5, "Catalyst Size (× ATR)",            group=G2, minval=0.5, step=0.1)
float i_fvg_pct  = input.float(0.5, "FVG Entry %  (0=top · 1=bottom)", group=G2, minval=0.0, maxval=1.0, step=0.05)

var string G3 = "Risk Management"
float i_rr_fb  = input.float(0.49, "Fallback R:R (no fractal found)", group=G3, minval=0.1, step=0.05)
float i_sl_buf = input.float(0.3,  "SL Buffer (× ATR)",               group=G3, minval=0.0, step=0.05)
float i_min_rr = input.float(0.2,  "Min R:R to accept fractal TP",    group=G3, minval=0.05, step=0.05)

var string G4 = "Fractal"
int i_frac_n = input.int(2, "Fractal Arms  (2 = 5-bar)", group=G4, minval=1, maxval=5)

var string G5 = "Display"
bool i_show_fvg  = input.bool(true, "Show FVG Zones",    group=G5)
bool i_show_frac = input.bool(true, "Show Fractals",      group=G5)
bool i_show_lbl  = input.bool(true, "Show Entry Labels",  group=G5)
bool i_show_tp   = input.bool(true, "Show TP / SL Lines", group=G5)

// ══════════════════════════════════════════════════════════════
//  SESSIONS
// ══════════════════════════════════════════════════════════════
bool in_lon  = i_lon and not na(time(timeframe.period, "0200-0500", "America/New_York"))
bool in_ny   = i_ny  and not na(time(timeframe.period, "0800-1100", "America/New_York"))
bool in_ses  = in_lon or in_ny
bool ses_end = in_ses[1] and not in_ses

// ══════════════════════════════════════════════════════════════
//  ATR + CATALYST CANDLE
// ══════════════════════════════════════════════════════════════
float atr  = ta.atr(i_atr_len)
float body = math.abs(close - open)

bool bull_cat = close > open and body > i_cat_mult * atr
bool bear_cat = close < open and body > i_cat_mult * atr

// ══════════════════════════════════════════════════════════════
//  BILL WILLIAMS FRACTAL  (5-bar default, arms=2)
//  Bear fractal → local HIGH → TP target for LONG trades
//  Bull fractal → local LOW  → TP target for SHORT trades
// ══════════════════════════════════════════════════════════════
int N = i_frac_n

bool bear_frac_ok = high[N] > high[N-1] and high[N] > high[N+1]
bool bull_frac_ok = low[N]  < low[N-1]  and low[N]  < low[N+1]

if N >= 2
    bear_frac_ok := bear_frac_ok and high[N] > high[N-2] and high[N] > high[N+2]
    bull_frac_ok := bull_frac_ok and low[N]  < low[N-2]  and low[N]  < low[N+2]
if N >= 3
    bear_frac_ok := bear_frac_ok and high[N] > high[N-3] and high[N] > high[N+3]
    bull_frac_ok := bull_frac_ok and low[N]  < low[N-3]  and low[N]  < low[N+3]
if N >= 4
    bear_frac_ok := bear_frac_ok and high[N] > high[N-4] and high[N] > high[N+4]
    bull_frac_ok := bull_frac_ok and low[N]  < low[N-4]  and low[N]  < low[N+4]
if N >= 5
    bear_frac_ok := bear_frac_ok and high[N] > high[N-5] and high[N] > high[N+5]
    bull_frac_ok := bull_frac_ok and low[N]  < low[N-5]  and low[N]  < low[N+5]

bool bear_fractal = bear_frac_ok
bool bull_fractal = bull_frac_ok

// Rolling arrays store last 30 confirmed fractal levels
var array<float> bear_fracs = array.new<float>()
var array<float> bull_fracs = array.new<float>()

// Only push fractals whose centre bar was inside a session;
// stale cross-session fractals would set active_tp far from current price
// and stretch the Y-axis, making K-bars shrink to the chart bottom.
if bear_fractal and in_ses[N]
    bear_fracs.push(high[N])
    if bear_fracs.size() > 30
        bear_fracs.shift()

if bull_fractal and in_ses[N]
    bull_fracs.push(low[N])
    if bull_fracs.size() > 30
        bull_fracs.shift()

// Search for nearest fractal above/below entry that gives >= i_min_rr
find_tp_above(float entry, float risk) =>
    float result  = na
    float best_rr = na
    for lvl in bear_fracs
        float rr = (lvl - entry) / risk
        if lvl > entry and rr >= i_min_rr
            if na(best_rr) or rr < best_rr
                result  := lvl
                best_rr := rr
    result

find_tp_below(float entry, float risk) =>
    float result  = na
    float best_rr = na
    for lvl in bull_fracs
        float rr = (entry - lvl) / risk
        if lvl < entry and rr >= i_min_rr
            if na(best_rr) or rr < best_rr
                result  := lvl
                best_rr := rr
    result

// ══════════════════════════════════════════════════════════════
//  FVG DETECTION  (3-candle ICT structure)
//  Bullish : low[0] > high[2]  AND  bull catalyst at bar[1]
//  Bearish : high[0] < low[2]  AND  bear catalyst at bar[1]
// ══════════════════════════════════════════════════════════════
bool bull_fvg = low  > high[2] and bull_cat[1] and in_ses[1]
bool bear_fvg = high < low[2]  and bear_cat[1] and in_ses[1]

// ══════════════════════════════════════════════════════════════
//  ZONE STATE + DYNAMIC BOX DRAWING
//  Boxes are stored as var references and their right edge
//  is updated every bar via box.set_right() so they follow
//  the chart as new K-bars arrive.
// ══════════════════════════════════════════════════════════════
var float bz_top = na
var float bz_bot = na
var bool  bz_on  = false
var int   bz_bar = na
var box   bz_box = na   // live reference → right edge updated each bar

var float sz_top = na
var float sz_bot = na
var bool  sz_on  = false
var int   sz_bar = na
var box   sz_box = na

// Active trade TP/SL stored as price levels; rendered via line.new() with
// moving x1 so no historical bar holds an absolute price → zero Y-axis distortion.
var float active_tp = na
var float active_sl = na
var line  tp_line   = na
var line  sl_line   = na

// ── Register new FVG
if bull_fvg
    bz_top := low
    bz_bot := high[2]
    bz_on  := true
    bz_bar := bar_index
    if i_show_fvg
        if not na(bz_box)
            box.delete(bz_box)
        bz_box := box.new(bar_index - 2, bz_top, bar_index, bz_bot,
             border_color = color.new(color.lime, 20),
             bgcolor      = color.new(color.lime, 82),
             border_width = 1,
             text         = "↑ Bull FVG",
             text_size    = size.tiny,
             text_color   = color.lime)

if bear_fvg
    sz_top := low[2]
    sz_bot := high
    sz_on  := true
    sz_bar := bar_index
    if i_show_fvg
        if not na(sz_box)
            box.delete(sz_box)
        sz_box := box.new(bar_index - 2, sz_top, bar_index, sz_bot,
             border_color = color.new(color.red, 20),
             bgcolor      = color.new(color.red, 82),
             border_width = 1,
             text         = "↓ Bear FVG",
             text_size    = size.tiny,
             text_color   = color.red)

// ── Extend active FVG boxes to current bar every tick
if bz_on and not na(bz_box)
    box.set_right(bz_box, bar_index)
if sz_on and not na(sz_box)
    box.set_right(sz_box, bar_index)

// ── Zone invalidation (BOS: price closes beyond far edge) – also delete box
if bz_on and close < bz_bot - i_sl_buf * atr
    bz_on := false
    if not na(bz_box)
        box.delete(bz_box)
        bz_box := na
if sz_on and close > sz_top + i_sl_buf * atr
    sz_on := false
    if not na(sz_box)
        box.delete(sz_box)
        sz_box := na
if ses_end
    bear_fracs.clear()   // purge stale fractal levels so next session starts clean
    bull_fracs.clear()
    bz_on := false
    sz_on := false
    if not na(bz_box)
        box.delete(bz_box)
        bz_box := na
    if not na(sz_box)
        box.delete(sz_box)
        sz_box := na
    active_tp := na
    active_sl := na
    if not na(tp_line)
        line.delete(tp_line)
        tp_line := na
    if not na(sl_line)
        line.delete(sl_line)
        sl_line := na

// ══════════════════════════════════════════════════════════════
//  ENTRIES
// ══════════════════════════════════════════════════════════════
bool flat      = strategy.position_size == 0
bool tradeable = flat and in_ses

// ── LONG: retracement into bullish FVG
bool long_in_zone = low <= bz_top and high >= bz_bot
bool long_cond    = tradeable and bz_on and bar_index > bz_bar and long_in_zone

if long_cond
    float entry_px = bz_bot + (bz_top - bz_bot) * (1.0 - i_fvg_pct)
    float sl_px    = bz_bot - i_sl_buf * atr
    float risk     = math.max(entry_px - sl_px, syminfo.mintick * 5)
    float frac_tp  = find_tp_above(entry_px, risk)
    bool  use_frac = not na(frac_tp)
    float tp_px    = use_frac ? frac_tp : entry_px + risk * i_rr_fb
    float achieved = (tp_px - entry_px) / risk

    strategy.entry("Long", strategy.long)
    strategy.exit("L-Exit", from_entry="Long", stop=sl_px, limit=tp_px)
    bz_on     := false
    active_tp := tp_px
    active_sl := sl_px

    if i_show_lbl
        string src = use_frac ? "FRAC" : "RR"
        label.new(bar_index, na,
             text      = "↑ L  " + src + "\n" + str.tostring(achieved, "#.##") + "R",
             yloc      = yloc.belowbar,
             style     = label.style_label_up,
             color     = use_frac ? color.lime : color.teal,
             textcolor = color.black,
             size      = size.small)

// ── SHORT: retracement into bearish FVG
bool short_in_zone = high >= sz_bot and low <= sz_top
bool short_cond    = tradeable and sz_on and bar_index > sz_bar and short_in_zone

if short_cond
    float entry_px = sz_top - (sz_top - sz_bot) * (1.0 - i_fvg_pct)
    float sl_px    = sz_top + i_sl_buf * atr
    float risk     = math.max(sl_px - entry_px, syminfo.mintick * 5)
    float frac_tp  = find_tp_below(entry_px, risk)
    bool  use_frac = not na(frac_tp)
    float tp_px    = use_frac ? frac_tp : entry_px - risk * i_rr_fb
    float achieved = (entry_px - tp_px) / risk

    strategy.entry("Short", strategy.short)
    strategy.exit("S-Exit", from_entry="Short", stop=sl_px, limit=tp_px)
    sz_on     := false
    active_tp := tp_px
    active_sl := sl_px

    if i_show_lbl
        string src = use_frac ? "FRAC" : "RR"
        label.new(bar_index, na,
             text      = "↓ S  " + src + "\n" + str.tostring(achieved, "#.##") + "R",
             yloc      = yloc.abovebar,
             style     = label.style_label_down,
             color     = use_frac ? color.red : color.maroon,
             textcolor = color.white,
             size      = size.small)

// ── Clear TP/SL levels once trade is closed
bool just_closed = strategy.position_size == 0 and strategy.position_size[1] != 0
if just_closed
    active_tp := na
    active_sl := na
    if not na(tp_line)
        line.delete(tp_line)
        tp_line := na
    if not na(sl_line)
        line.delete(sl_line)
        sl_line := na

// ── Moving-x TP/SL lines: x1 advances to current bar every tick so the line
//    has no historical anchor; deleted lines have zero Y-axis footprint.
if strategy.position_size != 0 and not na(active_tp) and i_show_tp
    if na(tp_line)
        tp_line := line.new(bar_index, active_tp, bar_index + 1, active_tp,
             color  = color.new(color.lime, 20),
             style  = line.style_dashed,
             width  = 1,
             extend = extend.right)
        sl_line := line.new(bar_index, active_sl, bar_index + 1, active_sl,
             color  = color.new(color.red, 20),
             style  = line.style_dashed,
             width  = 1,
             extend = extend.right)
    else
        line.set_x1(tp_line, bar_index)
        line.set_x2(tp_line, bar_index + 1)
        line.set_y1(tp_line, active_tp)
        line.set_y2(tp_line, active_tp)
        line.set_x1(sl_line, bar_index)
        line.set_x2(sl_line, bar_index + 1)
        line.set_y1(sl_line, active_sl)
        line.set_y2(sl_line, active_sl)

// ── Session-end force exit
if ses_end and not flat
    strategy.close_all(comment="EOD")

// ══════════════════════════════════════════════════════════════
//  VISUALS
// ══════════════════════════════════════════════════════════════
bgcolor(in_lon ? color.new(color.blue,   92) : na, title="London Window")
bgcolor(in_ny  ? color.new(color.orange, 92) : na, title="NY Window")

barcolor(bull_cat and in_ses ? color.new(color.lime, 0) : na, title="Bull Catalyst")
barcolor(bear_cat and in_ses ? color.new(color.red,  0) : na, title="Bear Catalyst")

// TP/SL lines are managed via line.new() with moving x1 (see above).
// plot() is intentionally absent: its persistent series permanently
// anchors the Y-axis at every historical bar where it was non-na.

// Fractal markers via label.new() at the actual fractal bar (bar_index - N).
// yloc.abovebar/belowbar is relative to bar high/low → never distorts Y-axis.
if i_show_frac and bear_fractal and in_ses[N]
    label.new(bar_index - N, na,
         text      = "▼",
         yloc      = yloc.abovebar,
         style     = label.style_none,
         color     = color.new(color.orange, 100),
         textcolor = color.orange,
         size      = size.tiny)

if i_show_frac and bull_fractal and in_ses[N]
    label.new(bar_index - N, na,
         text      = "▲",
         yloc      = yloc.belowbar,
         style     = label.style_none,
         color     = color.new(color.aqua, 100),
         textcolor = color.aqua,
         size      = size.tiny)

// ══════════════════════════════════════════════════════════════
//  INFO TABLE  (top-right)
// ══════════════════════════════════════════════════════════════
var table tbl = table.new(position.top_right, 2, 7,
     bgcolor      = color.new(color.black, 70),
     border_color = color.new(color.gray, 50),
     border_width = 1,
     frame_color  = color.new(color.gray, 50),
     frame_width  = 1)

if barstate.islastconfirmedhistory or barstate.islast
    int   total = strategy.closedtrades
    float wr    = total > 0 ? strategy.wintrades / total * 100 : 0.0
    float pf    = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0

    table.cell(tbl, 0, 0, "GH FVG + FRACTAL TP  v3",
         text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 60))
    table.cell(tbl, 1, 0, "0.49 RR",
         text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 60))
    table.cell(tbl, 0, 1, "Win Rate",
         text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 1, str.tostring(wr, "#.1") + "%",
         text_color=wr >= 65 ? color.lime : color.red, text_size=size.tiny)
    table.cell(tbl, 0, 2, "Profit Factor",
         text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 2, str.tostring(pf, "#.##"),
         text_color=pf >= 1.0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(tbl, 0, 3, "Total Trades",
         text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 3, str.tostring(total),
         text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 4, "Net P&L",
         text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 4, str.tostring(strategy.netprofit, "#.##"),
         text_color=strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(tbl, 0, 5, "Max Drawdown",
         text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 5, str.tostring(strategy.max_drawdown, "#.##"),
         text_color=color.orange, text_size=size.tiny)
    table.cell(tbl, 0, 6, "Final Equity",
         text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 6, str.tostring(strategy.equity, "#.##"),
         text_color=color.white, text_size=size.tiny)
