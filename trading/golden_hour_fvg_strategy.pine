//@version=5
strategy(
     title                 = "Golden Hour – ICT/SMC FVG Strategy (Chanelle Style)",
     overlay               = true,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 5,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.02,
     slippage              = 2,
     process_bars_on_close = true,
     max_boxes_count       = 500,
     max_labels_count      = 500)

// ══════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════
var G1 = "─── Sessions (New York Time) ───"
i_lon = input.bool(true,  "London Open  02:00 – 05:00 ET", group=G1)
i_ny  = input.bool(true,  "NY Open      08:00 – 11:00 ET", group=G1)

var G2 = "─── Catalyst Candle / FVG ───"
i_atr_len  = input.int  (14,  "ATR Length",                              group=G2, minval=1)
i_cat_mult = input.float(1.5, "Catalyst Candle Min Size (× ATR)",        group=G2, minval=0.5,  step=0.1)
i_fvg_pct  = input.float(0.5, "FVG Entry Level  (0 = top · 1 = bottom)", group=G2, minval=0.0,  maxval=1.0, step=0.05)

var G3 = "─── Risk Management ───"
i_rr     = input.float(2.0, "Risk : Reward Ratio",            group=G3, minval=0.5, step=0.5)
i_sl_buf = input.float(0.3, "Stop-Loss Buffer (× ATR)",       group=G3, minval=0.0, step=0.05)

var G4 = "─── Display ───"
i_show_boxes  = input.bool(true, "Show FVG Boxes",      group=G4)
i_show_labels = input.bool(true, "Show Entry Labels",   group=G4)

// ══════════════════════════════════════════════════════════════
//  SESSION WINDOWS  (Eastern Time)
// ══════════════════════════════════════════════════════════════
in_lon = i_lon and not na(time(timeframe.period, "0200-0500", "America/New_York"))
in_ny  = i_ny  and not na(time(timeframe.period, "0800-1100", "America/New_York"))
in_ses = in_lon or in_ny
ses_end = in_ses[1] and not in_ses   // transition out of session

// ══════════════════════════════════════════════════════════════
//  ATR  +  CATALYST CANDLE DETECTION
//  A "Catalyst" = a strong, directional bar larger than N × ATR
//  It is the engine that creates the Fair Value Gap.
// ══════════════════════════════════════════════════════════════
atr  = ta.atr(i_atr_len)
body = math.abs(close - open)

bull_cat = close > open and body > i_cat_mult * atr   // strong bullish bar
bear_cat = close < open and body > i_cat_mult * atr   // strong bearish bar

// ══════════════════════════════════════════════════════════════
//  FAIR VALUE GAP (FVG)  –  3-candle ICT/SMC structure
//
//  Bullish FVG  (price gaps UP):
//    bar[-2] high  <  bar[0] low   ← gap between them
//    bar[-1] = catalyst (the powerful bull bar in the middle)
//
//  Bearish FVG  (price gaps DOWN):
//    bar[-2] low   >  bar[0] high  ← gap between them
//    bar[-1] = catalyst (the powerful bear bar in the middle)
//
//  Naming convention:  _top = higher price  /  _bot = lower price
// ══════════════════════════════════════════════════════════════
bull_fvg = low  > high[2] and bull_cat[1] and in_ses[1]
bear_fvg = high < low[2]  and bear_cat[1] and in_ses[1]

// FVG zone coordinates (captured at the moment of formation)
bull_fvg_top = low           // upper edge of bullish gap
bull_fvg_bot = high[2]       // lower edge of bullish gap
bear_fvg_top = low[2]        // upper edge of bearish gap
bear_fvg_bot = high          // lower edge of bearish gap

// ══════════════════════════════════════════════════════════════
//  ZONE STATE MACHINE
// ══════════════════════════════════════════════════════════════
var float bz_top = na       // active bullish zone – top
var float bz_bot = na       // active bullish zone – bottom
var bool  bz_on  = false
var int   bz_bar = na       // bar_index when FVG formed

var float sz_top = na       // active bearish zone – top
var float sz_bot = na       // active bearish zone – bottom
var bool  sz_on  = false
var int   sz_bar = na

// Register newest FVG (overwrite if another forms before entry)
if bull_fvg
    bz_top := bull_fvg_top
    bz_bot := bull_fvg_bot
    bz_on  := true
    bz_bar := bar_index

if bear_fvg
    sz_top := bear_fvg_top
    sz_bot := bear_fvg_bot
    sz_on  := true
    sz_bar := bar_index

// ── Invalidation: price closes BEYOND the far edge of zone (BOS)
if bz_on and close < bz_bot - i_sl_buf * atr
    bz_on := false

if sz_on and close > sz_top + i_sl_buf * atr
    sz_on := false

// ── Clear zones at session close
if ses_end
    bz_on := false
    sz_on := false

// ══════════════════════════════════════════════════════════════
//  ENTRIES
//  Wait for price to RETRACE back into the FVG zone,
//  then enter at the configured FVG level (default = midpoint).
//  `bar_index > bz_bar` prevents same-bar entry when FVG first forms.
// ══════════════════════════════════════════════════════════════
flat      = strategy.position_size == 0
tradeable = flat and in_ses

//  ── LONG ──
long_cond = tradeable and bz_on
            and bar_index > bz_bar         // must be AFTER the FVG formed
            and low  <= bz_top             // price touched top of gap
            and high >= bz_bot             // price is inside the zone

if long_cond
    entry_px = bz_bot + (bz_top - bz_bot) * (1.0 - i_fvg_pct)   // e.g. midpoint
    sl_px    = bz_bot - i_sl_buf * atr
    risk     = math.max(entry_px - sl_px, syminfo.mintick * 5)
    tp_px    = entry_px + risk * i_rr

    strategy.entry("Long",    strategy.long)
    strategy.exit ("L-TP/SL", from_entry="Long",  stop=sl_px, limit=tp_px)
    bz_on := false

    if i_show_labels
        label.new(bar_index, low,
             text       = "L\nRR " + str.tostring(i_rr, "#.#"),
             style      = label.style_label_up,
             color      = color.lime,
             textcolor  = color.black,
             size       = size.small)

//  ── SHORT ──
short_cond = tradeable and sz_on
             and bar_index > sz_bar
             and high >= sz_bot            // price touched bottom of gap
             and low  <= sz_top            // price is inside the zone

if short_cond
    entry_px = sz_top - (sz_top - sz_bot) * (1.0 - i_fvg_pct)
    sl_px    = sz_top + i_sl_buf * atr
    risk     = math.max(sl_px - entry_px, syminfo.mintick * 5)
    tp_px    = entry_px - risk * i_rr

    strategy.entry("Short",   strategy.short)
    strategy.exit ("S-TP/SL", from_entry="Short", stop=sl_px, limit=tp_px)
    sz_on := false

    if i_show_labels
        label.new(bar_index, high,
             text       = "S\nRR " + str.tostring(i_rr, "#.#"),
             style      = label.style_label_down,
             color      = color.red,
             textcolor  = color.white,
             size       = size.small)

//  ── SESSION-END FORCE EXIT ──
if ses_end and not flat
    strategy.close_all(comment="Session End")

// ══════════════════════════════════════════════════════════════
//  VISUALS
// ══════════════════════════════════════════════════════════════

// Session background
bgcolor(in_lon ? color.new(color.blue,   92) : na, title="London Window")
bgcolor(in_ny  ? color.new(color.orange, 92) : na, title="NY Window")

// Catalyst bar highlight
barcolor(bull_cat and in_ses ? color.new(color.lime, 0) : na, title="Bull Catalyst")
barcolor(bear_cat and in_ses ? color.new(color.red,  0) : na, title="Bear Catalyst")

// FVG zone boxes
if i_show_boxes
    if bull_fvg
        box.new(
             bar_index - 2, bull_fvg_top,
             bar_index + 40, bull_fvg_bot,
             border_color = color.new(color.lime, 30),
             bgcolor      = color.new(color.lime, 82),
             border_width = 1,
             text         = "↑ Bull FVG",
             text_size    = size.tiny,
             text_color   = color.lime)

    if bear_fvg
        box.new(
             bar_index - 2, bear_fvg_top,
             bar_index + 40, bear_fvg_bot,
             border_color = color.new(color.red,  30),
             bgcolor      = color.new(color.red,  82),
             border_width = 1,
             text         = "↓ Bear FVG",
             text_size    = size.tiny,
             text_color   = color.red)

// ══════════════════════════════════════════════════════════════
//  INFO TABLE  (top-right)
// ══════════════════════════════════════════════════════════════
var table info = table.new(position.top_right, 2, 6,
     bgcolor      = color.new(color.black, 70),
     border_color = color.new(color.gray, 50),
     border_width = 1,
     frame_color  = color.new(color.gray, 50),
     frame_width  = 1)

if barstate.islastconfirmedhistory or barstate.islast
    wins   = strategy.wintrades
    losses = strategy.losstrades
    total  = strategy.closedtrades
    wr     = total > 0 ? wins / total * 100 : 0.0
    pf     = strategy.grossprofit > 0 and strategy.grossloss > 0
             ? strategy.grossprofit / strategy.grossloss : 0.0

    table.cell(info, 0, 0, "GOLDEN HOUR FVG",
         text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 60))
    table.cell(info, 1, 0, "Stats",
         text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 60))

    table.cell(info, 0, 1, "Win Rate",       text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 1, str.tostring(wr, "#.1") + "%",
         text_color = wr >= 50 ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 2, "Profit Factor",  text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 2, str.tostring(pf,  "#.##"),
         text_color = pf >= 1.5 ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 3, "Total Trades",   text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 3, str.tostring(total),
         text_color=color.white, text_size=size.tiny)

    table.cell(info, 0, 4, "Net P&L",        text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 4, str.tostring(strategy.netprofit, "#.##"),
         text_color = strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 5, "Max Drawdown",   text_color=color.silver, text_size=size.tiny)
    table.cell(info, 1, 5, str.tostring(strategy.max_drawdown, "#.##"),
         text_color=color.orange, text_size=size.tiny)
